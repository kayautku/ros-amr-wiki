<?xml version="1.0"?>
<!--
  Örnek depo: 20 x 12 m oda, ortada 1,5 m'lik kapılı bir bölme duvarı ve iki sütun.
  Duvarlar 2,5 m yüksek: robotun üst lidarı (zeminden ~1,7 m) de görebilsin.
-->
<sdf version="1.6">
  <world name="depo">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="duvarlar">
      <static>true</static>
      <!-- Dış duvarlar: x = -4 … 16, y = -6 … 6 -->
      <link name="kuzey"><pose>6 6.1 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.4 0.2 2.5</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link>
      <link name="guney"><pose>6 -6.1 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.4 0.2 2.5</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link>
      <link name="bati"><pose>-4.1 0 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 12.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 12.0 2.5</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link>
      <link name="dogu"><pose>16.1 0 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 12.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 12.0 2.5</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link>
      <!-- Bölme duvarı x = 6, ortasında y = -0,75 … +0,75 arası 1,5 m kapı -->
      <link name="bolme_kuzey"><pose>6 3.375 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.25 2.5</size></box></geometry><material><ambient>0.7 0.7 0.9 1</ambient><diffuse>0.7 0.7 0.9 1</diffuse></material></visual></link>
      <link name="bolme_guney"><pose>6 -3.375 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.25 2.5</size></box></geometry><material><ambient>0.7 0.7 0.9 1</ambient><diffuse>0.7 0.7 0.9 1</diffuse></material></visual></link>
      <!-- İki sütun -->
      <link name="sutun_1"><pose>11 3 1.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>1 1 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 2.0</size></box></geometry><material><ambient>0.9 0.7 0.5 1</ambient><diffuse>0.9 0.7 0.5 1</diffuse></material></visual></link>
      <link name="sutun_2"><pose>11 -3 1.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>1 1 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 2.0</size></box></geometry><material><ambient>0.9 0.7 0.5 1</ambient><diffuse>0.9 0.7 0.5 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
