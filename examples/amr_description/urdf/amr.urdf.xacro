<?xml version="1.0"?>
<robot name="amr">

    <!-- Base footprint -->
    <link name="base_footprint">
        <inertial>
            <origin xyz="0 0 0.317" rpy="0 0 0"/>
            <mass value="250.0"/>
            <inertia ixx="45.0" ixy="0.0" ixz="0.0" iyy="75.0" iyz="0.0" izz="105.0"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0.317" rpy="0 0 0"/>
            <geometry>
                <box size="1.8 1.3 0.334"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0.317" rpy="0 0 0"/>
            <geometry>
                <box size="1.8 1.3 0.334"/>
            </geometry>
        </visual>
    </link>

    <gazebo reference="base_footprint">
        <material>Gazebo/Orange</material>
    </gazebo>

    <!-- Left wheel -->
    <link name="left_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.15" length="0.08"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.15" length="0.08"/>
            </geometry>
        </collision>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_footprint"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.5 0.15" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Right wheel -->
    <link name="right_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.15" length="0.08"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.15" length="0.08"/>
            </geometry>
        </collision>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_footprint"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.5 0.15" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Front-left caster wheel -->
    <link name="front_left_caster_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.10"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.10"/>
            </geometry>
        </collision>
    </link>

    <joint name="front_left_caster_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="front_left_caster_wheel"/>
        <origin xyz="0.75 0.40 0.10" rpy="0 0 0"/>
    </joint>

    <gazebo reference="front_left_caster_wheel">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Front-right caster wheel -->
    <link name="front_right_caster_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.10"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.10"/>
            </geometry>
        </collision>
    </link>

    <joint name="front_right_caster_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="front_right_caster_wheel"/>
        <origin xyz="0.75 -0.40 0.10" rpy="0 0 0"/>
    </joint>

    <gazebo reference="front_right_caster_wheel">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Rear-left caster wheel -->
    <link name="rear_left_caster_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.10"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.10"/>
            </geometry>
        </collision>
    </link>

    <joint name="rear_left_caster_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="rear_left_caster_wheel"/>
        <origin xyz="-0.75 0.40 0.10" rpy="0 0 0"/>
    </joint>

    <gazebo reference="rear_left_caster_wheel">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Rear-right caster wheel -->
    <link name="rear_right_caster_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.10"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.10"/>
            </geometry>
        </collision>
    </link>

    <joint name="rear_right_caster_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="rear_right_caster_wheel"/>
        <origin xyz="-0.75 -0.40 0.10" rpy="0 0 0"/>
    </joint>

    <gazebo reference="rear_right_caster_wheel">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Front-left lidar -->
    <link name="front_left_lidar_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
            <material name="invisible">
                <color rgba="0 0 0 0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
        </collision>
    </link>

    <joint name="front_left_lidar_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="front_left_lidar_link"/>
        <origin xyz="0.90 0.65 0.317" rpy="0 0 0.785"/>
    </joint>

    <gazebo reference="front_left_lidar_link">
        <material>Gazebo/Red</material>
        <sensor type="ray" name="front_left_lidar_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-2.18166</min_angle>
                        <max_angle>2.18166</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="gazebo_ros_front_left_lidar_controller" filename="libgazebo_ros_laser.so">
                <topicName>/scan_front_left</topicName>
                <frameName>front_left_lidar_link</frameName>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Rear-right lidar -->
    <link name="rear_right_lidar_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
            <material name="invisible">
                <color rgba="0 0 0 0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.06"/>
            </geometry>
        </collision>
    </link>

    <joint name="rear_right_lidar_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="rear_right_lidar_link"/>
        <origin xyz="-0.90 -0.65 0.317" rpy="0 0 -2.356"/>
    </joint>

    <gazebo reference="rear_right_lidar_link">
        <material>Gazebo/Red</material>
        <sensor type="ray" name="rear_right_lidar_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-2.18166</min_angle>
                        <max_angle>2.18166</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="gazebo_ros_rear_right_lidar_controller" filename="libgazebo_ros_laser.so">
                <topicName>/scan_rear_right</topicName>
                <frameName>rear_right_lidar_link</frameName>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Top lidar -->
    <link name="top_lidar_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.06" length="0.08"/>
            </geometry>
            <material name="invisible">
                <color rgba="0 0 0 0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.06" length="0.08"/>
            </geometry>
        </collision>
    </link>

    <joint name="top_lidar_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="top_lidar_link"/>
        <origin xyz="-0.85 0.0 1.54" rpy="0 0 0"/>
    </joint>

    <gazebo reference="top_lidar_link">
        <material>Gazebo/Blue</material>
        <sensor type="ray" name="top_lidar_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <update_rate>15</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.20</min>
                    <max>25.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="gazebo_ros_top_lidar_controller" filename="libgazebo_ros_laser.so">
                <topicName>/scan_top</topicName>
                <frameName>top_lidar_link</frameName>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Kule -->
    <link name="kule_link">
        <inertial>
            <origin xyz="0 0 0.508" rpy="0 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0 0.175 0.508" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 1.016"/>
            </geometry>
            <material name="dark_grey">
                <color rgba="0.4 0.4 0.4 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0.175 0.508" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 1.016"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 -0.175 0.508" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 1.016"/>
            </geometry>
            <material name="dark_grey">
                <color rgba="0.4 0.4 0.4 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 -0.175 0.508" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 1.016"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0.20" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.30 0.05"/>
            </geometry>
            <material name="dark_grey">
                <color rgba="0.4 0.4 0.4 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.20" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.30 0.05"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0.508" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.30 0.05"/>
            </geometry>
            <material name="dark_grey">
                <color rgba="0.4 0.4 0.4 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.508" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.30 0.05"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0.991" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.30 0.05"/>
            </geometry>
            <material name="dark_grey">
                <color rgba="0.4 0.4 0.4 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.991" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.30 0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="kule_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="kule_link"/>
        <origin xyz="-0.850 0.0 0.484" rpy="0 0 0"/>
    </joint>

    <gazebo reference="kule_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Camera -->
    <link name="camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.10 0.05"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.10 0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="camera_link"/>
        <origin xyz="0.95 0.0 0.484" rpy="0 0.785 0"/>
    </joint>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
        <sensor type="camera" name="chassis_camera">
            <update_rate>30.0</update_rate>
            <camera name="front_cam">
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>300</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <alwaysOn>true</alwaysOn>
                <updateRate>30.0</updateRate>
                <cameraName>robot/camera</cameraName>
                <imageTopicName>image_raw</imageTopicName>
                <cameraInfoTopicName>camera_info</cameraInfoTopicName>
                <frameName>camera_link</frameName>
                <distortionK1>0.0</distortionK1>
                <distortionK2>0.0</distortionK2>
                <distortionK3>0.0</distortionK3>
                <distortionT1>0.0</distortionT1>
                <distortionT2>0.0</distortionT2>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Differential drive plugin -->
    <gazebo>
        <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <updateRate>100</updateRate>
            <leftJoint>left_wheel_joint</leftJoint>
            <rightJoint>right_wheel_joint</rightJoint>
            <wheelSeparation>1.0</wheelSeparation>
            <wheelDiameter>0.30</wheelDiameter>
            <wheelAcceleration>3.0</wheelAcceleration>
            <wheelTorque>100</wheelTorque>
            <commandTopic>cmd_vel</commandTopic>
            <odometryTopic>odom</odometryTopic>
            <odometryFrame>odom</odometryFrame>
            <robotBaseFrame>base_footprint</robotBaseFrame>
            <publishWheelTF>false</publishWheelTF>
            <publishOdomTF>true</publishOdomTF>
            <publishWheelJointState>true</publishWheelJointState>
            <legacyMode>false</legacyMode>
        </plugin>
    </gazebo>

</robot>
